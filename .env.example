# Frontend: set this in Netlify -> Site configuration -> Environment variables.
# Include /api at the end.
VITE_API_BASE_URL=https://YOUR-KEYZO-BACKEND.onrender.com/api

# Backend-only environment variables (configure on Render, never in frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=\nRAZORPAY_WEBHOOK_SECRET=

# Optional external lead-source bridge. JSON map of private token -> organization ID.
# Example: LEAD_SOURCE_TOKENS={"replace-with-long-random-token":"default"}
LEAD_SOURCE_TOKENS=
